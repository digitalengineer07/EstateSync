# Development: use the development Neon DATABASE_URL and local private files.
# Keep DOCUMENT_STORAGE_PROVIDER=local (or omit it). Outside production, the
# default folder is backend/private-documents; it is ignored by Git.
# DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_PATH=D:\EstateSync\backend\private-documents

# Production on Hostinger managed Node: configure a PRIVATE S3-compatible bucket
# (for example Cloudflare R2). Do not enable a public bucket URL or website access.
# Set these as backend environment variables in the host, not in frontend/public.
# Use the production Neon DATABASE_URL separately from the development database.
# DOCUMENT_STORAGE_PROVIDER=s3
# DOCUMENT_S3_BUCKET=estatesync-private-production
# DOCUMENT_S3_REGION=auto
# DOCUMENT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# DOCUMENT_S3_ACCESS_KEY_ID=<bucket-scoped-key-id>
# DOCUMENT_S3_SECRET_ACCESS_KEY=<bucket-scoped-secret>

# Alternative only if the host guarantees a persistent private directory outside
# public_html and deployment-replaced folders:
# DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_PATH=/absolute/private/persistent/documents

# ClamAV daemon must be installed, updated, and reachable from the backend host.
# TCP port 3310 is unauthenticated: bind it to loopback or a private network only.
# Configure clamd StreamMaxLength above the 10 MB application upload limit.
DOCUMENT_SCANNER_PROVIDER=clamav
DOCUMENT_SCANNER_REQUIRED=true
DOCUMENT_CLAMAV_HOST=127.0.0.1
DOCUMENT_CLAMAV_PORT=3310
DOCUMENT_CLAMAV_TIMEOUT_MS=15000
