generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String
  name           String
  roleId         String
  role           Role             @relation(fields: [roleId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  wallet         Wallet?
  fundRequests   FundRequest[]    @relation("UserRequests")
  managedRequests FundRequest[]   @relation("ManagerRequests")
  expenses       Expense[]
}

model Role {
  id          String             @id @default(uuid())
  name        String             @unique // ADMIN, MANAGER, SALES, MARKETING, ACCOUNTING, OTHER
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Permission {
  id          String             @id @default(uuid())
  code        String             @unique // e.g., fund.allocate, expense.create
  description String?
  roles       RolePermission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Wallet {
  id               String               @id @default(uuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id])
  totalAllocated   Decimal              @db.Decimal(15, 2) @default(0)
  totalSpent       Decimal              @db.Decimal(15, 2) @default(0)
  availableBalance Decimal              @db.Decimal(15, 2) @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactionsSrc  WalletTransaction[]  @relation("SourceWallet")
  transactionsDest WalletTransaction[]  @relation("DestWallet")
  expenses         Expense[]
}

model WalletTransaction {
  id               String       @id @default(uuid())
  type             String       // FUND_ALLOCATION, FUND_TRANSFER, EXPENSE, etc.
  sourceWalletId   String?
  destWalletId     String?
  sourceWallet     Wallet?      @relation("SourceWallet", fields: [sourceWalletId], references: [id])
  destWallet       Wallet?      @relation("DestWallet", fields: [destWalletId], references: [id])
  amount           Decimal      @db.Decimal(15, 2)
  referenceType    String?
  referenceId      String?
  description      String?
  createdBy        String
  status           String
  createdAt        DateTime     @default(now())
}

model FundRequest {
  id               String       @id @default(uuid())
  requesterId      String
  managerId        String
  requester        User         @relation("UserRequests", fields: [requesterId], references: [id])
  manager          User         @relation("ManagerRequests", fields: [managerId], references: [id])
  parentRequestId  String?
  parentRequest    FundRequest? @relation("ParentRequest", fields: [parentRequestId], references: [id])
  childRequests    FundRequest[] @relation("ParentRequest")
  requestedFrom    String?      // ADMIN, MANAGER
  amount           Decimal      @db.Decimal(15, 2)
  reason           String
  status           String       // PENDING, APPROVED, REJECTED, INSUFFICIENT_MANAGER_FUNDS
  comments         String?
  approvedBy       String?
  rejectedBy       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Expense {
  id               String       @id @default(uuid())
  userId           String
  walletId         String
  user             User         @relation(fields: [userId], references: [id])
  wallet           Wallet       @relation(fields: [walletId], references: [id])
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount           Decimal      @db.Decimal(15, 2)
  description      String
  date             DateTime
  vendorId         String?
  reference        String?
  attachment       String?
  status           String       // RECORDED, REVERSED
  createdAt        DateTime     @default(now())
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  expenses    Expense[]
}
